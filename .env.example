# --- AI provider -----------------------------------------------------------
# "anthropic" or "mock". Mock returns canned output so the UI runs with no key.
# If AI_API_KEY (or ANTHROPIC_API_KEY) is missing, the server falls back to mock.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max — how hard the model thinks per request.
# high is the quality default; medium is noticeably faster if latency matters more.
AI_EFFORT=high

# --- Server ---------------------------------------------------------------
PORT=3000

# --- Conversation engine --------------------------------------------------
# How many recent messages are sent to the model (Layer A context).
RECENT_MESSAGE_LIMIT=30
# Phase 2: wait this long after an incoming message before analysing,
# so rapid-fire messages are batched into one analysis.
MESSAGE_BATCH_SECONDS=5

# --- Phase 2 (WhatsApp) — not used yet ------------------------------------
WHATSAPP_SESSION_PATH=./data/whatsapp-session
DATABASE_PATH=./data/homeair.db
