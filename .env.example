# --- AI provider -----------------------------------------------------------
# bridge    (default) local LLM bridge — uses this machine's Claude Code login.
#           No API key. Requires the bridge to be running (npm run dev starts it).
# anthropic direct Anthropic API — needs AI_API_KEY. Falls back to mock without one.
# mock      canned output; nothing leaves the machine. Used by tests.
AI_PROVIDER=bridge

# Optional model alias/id passed to the provider ("opus", "sonnet", or a full id).
# Empty = the provider's default (for the bridge: your Claude Code default model).
AI_MODEL=
# Optional: low | medium | high | xhigh | max. Empty = provider default.
AI_EFFORT=

# Only for AI_PROVIDER=anthropic.
AI_API_KEY=

# --- LLM bridge (apps/llm-bridge) ------------------------------------------
BRIDGE_PORT=4317
# Where HomeAIR finds the bridge. Defaults to http://127.0.0.1:${BRIDGE_PORT}.
BRIDGE_URL=
# Optional shared secret. If set, the bridge requires it and HomeAIR sends it.
BRIDGE_TOKEN=
# Parallel model processes the bridge will run.
BRIDGE_MAX_CONCURRENCY=2
# Path to the claude binary if it is not on PATH.
CLAUDE_BIN=

# --- HomeAIR server ---------------------------------------------------------
PORT=3000

# --- Conversation engine ----------------------------------------------------
# How many recent messages are sent to the model (Layer A context).
RECENT_MESSAGE_LIMIT=30
# Phase 2: wait this long after an incoming message before analysing,
# so rapid-fire messages are batched into one analysis.
MESSAGE_BATCH_SECONDS=5

# --- Phase 2 (WhatsApp) — not used yet --------------------------------------
WHATSAPP_SESSION_PATH=./data/whatsapp-session
DATABASE_PATH=./data/homeair.db
